{
  "openapi": "3.1.0",
  "info": {
    "title": "Mini Supermarket API - Buoi 7 Vinh V2/V3",
    "version": "0.7.0"
  },
  "paths": {
    "/api/v1/products": {
      "get": {
        "summary": "Tìm kiếm sản phẩm có điều kiện",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": { "type": "string", "maxLength": 100 }
          },
          {
            "in": "query",
            "name": "category_id",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "in": "query",
            "name": "min_price",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "in": "query",
            "name": "max_price",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "in": "query",
            "name": "in_stock",
            "schema": { "type": "boolean" }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "enum": ["product_id", "product_name", "price", "stock"],
              "default": "product_id"
            }
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách active products và COUNT theo cùng bộ lọc"
          },
          "400": { "description": "Tham số không hợp lệ" }
        }
      }
    },
    "/api/v1/reports/revenue": {
      "get": {
        "summary": "R1 - Báo cáo doanh thu theo ngày",
        "description": "Chỉ tính orders.payment_status=paid có payments.status=paid, paid_at trong khoảng [from 00:00, ngày sau to 00:00) theo Asia/Ho_Chi_Minh; loại cancelled/rejected. Mỗi đơn chỉ cộng một lần. data.summary gồm order_count, revenue (SUM final_amount), discount_amount; data.series nhóm các số liệu theo DATE(paid_at); data.data_quality.paid_without_paid_at cảnh báo các đơn paid có thanh toán nhưng thiếu paid_at. Export CSV dùng chính dữ liệu đã trả về.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" }
        ],
        "responses": {
          "200": {
            "description": "Admin only; data and meta include filter, timezone, VND currency, generation time"
          },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Forbidden" },
          "400": {
            "description": "Invalid date range; from/to required and range limited to 366 days"
          }
        }
      }
    },
    "/api/v1/reports/products": {
      "get": {
        "summary": "R2 - Báo cáo sản phẩm",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" }
        ],
        "responses": {
          "200": { "description": "Admin only" },
          "403": { "description": "Forbidden" },
          "400": { "description": "Date invalid" }
        }
      }
    },
    "/api/v1/reports/employees": {
      "get": {
        "summary": "R3 - Báo cáo doanh thu nhân viên",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" }
        ],
        "responses": {
          "200": { "description": "Admin only" },
          "403": { "description": "Forbidden" },
          "400": { "description": "Date invalid" }
        }
      }
    },
    "/api/v1/reports/employees/{employeeId}/activity": {
      "get": {
        "summary": "Lịch sử đơn đã xử lý và ca làm của nhân viên",
        "description": "Admin only. Orders được lọc theo employee_id và thời điểm COALESCE(confirmed_at, paid_at, created_at); work_shifts theo shift_date. Khoảng ngày Asia/Ho_Chi_Minh, tối đa 366 ngày; danh sách đơn phân trang tối đa 20.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "employeeId",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          },
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee summary, paged handled orders and shifts"
          },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Employee not found" },
          "400": { "description": "Invalid date range or pagination" }
        }
      }
    },
    "/api/v1/vouchers/available": {
      "get": {
        "summary": "Voucher khách chưa lưu",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Customer only; active, unexpired, global usage remains, and not already saved"
          },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/vouchers/mine": {
      "get": {
        "summary": "Voucher đã lưu của khách",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Customer only; includes usable status and customer usage count"
          },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/vouchers/claim": {
      "post": {
        "summary": "Lưu voucher vào tài khoản khách",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "voucher_id": { "type": "integer", "minimum": 1 },
                  "voucher_code": { "type": "string", "maxLength": 50 }
                },
                "oneOf": [
                  { "required": ["voucher_id"] },
                  { "required": ["voucher_code"] }
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Claimed voucher" },
          "403": { "description": "Customer only" },
          "409": { "description": "Global usage exhausted" },
          "410": { "description": "Expired" }
        }
      }
    },
    "/api/v1/vouchers/customers/{customerId}": {
      "get": {
        "summary": "Voucher đã lưu của khách tại POS",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Employee/Admin only" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/audit-logs": {
      "get": {
        "summary": "Tra cứu audit log",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "actor_id",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "in": "query",
            "name": "action",
            "schema": {
              "type": "string",
              "enum": [
                "LOGIN_SUCCESS",
                "LOGIN_FAILURE",
                "ROLE_CHANGED",
                "DATA_DELETED"
              ]
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "schema": { "type": "string", "enum": ["SUCCESS", "FAILURE"] }
          },
          { "$ref": "#/components/parameters/from" },
          { "$ref": "#/components/parameters/to" },
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": { "description": "Admin only" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "Thông báo của chính người dùng",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Chỉ trả thông báo thuộc recipient_user_id" }
        }
      }
    },
    "/api/v1/notifications/{id}/read": {
      "patch": {
        "summary": "Đánh dấu đã đọc",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Updated" },
          "404": { "description": "Không tìm thấy notification của người dùng" }
        }
      }
    },
    "/api/v1/auth/me/password": {
      "patch": {
        "summary": "Đổi mật khẩu khi đã đăng nhập",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["current_password", "new_password"],
                "properties": {
                  "current_password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed and sessions revoked" },
          "401": { "description": "Mật khẩu hiện tại sai" }
        }
      }
    },
    "/api/v1/auth/password-reset/request": {
      "post": {
        "summary": "Yêu cầu khôi phục mật khẩu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Phản hồi chung, không tiết lộ email có tồn tại"
          },
          "429": { "description": "Rate limited" }
        }
      }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": {
        "summary": "Xác nhận khôi phục bằng token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "new_password"],
                "properties": {
                  "token": { "type": "string" },
                  "new_password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reset thành công; token dùng một lần" },
          "400": { "description": "Token invalid/expired" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "from": {
        "in": "query",
        "name": "from",
        "required": true,
        "schema": { "type": "string", "format": "date" }
      },
      "to": {
        "in": "query",
        "name": "to",
        "required": true,
        "schema": { "type": "string", "format": "date" }
      }
    }
  }
}
